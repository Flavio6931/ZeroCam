# Plantilla de configuración para firmar el APK Release con ECDSA P-256 (v2 + v3)
# Copia este archivo como `android/keystore.properties` (ignorado por Git) y reemplaza los valores.
#
# Generar un keystore ECDSA P-256 nuevo:
# keytool -genkeypair -v -keystore zerocam-release-ec.jks -alias zerocam ^
#   -keyalg EC -groupname secp256r1 -sigalg SHA256withECDSA -validity 10000

storeFile=zerocam-release-ec.jks
storePassword=CHANGE_ME
keyAlias=zerocam
keyPassword=CHANGE_ME
