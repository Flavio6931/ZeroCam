<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ZeroCamMobile" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent_primary</item>
        <item name="colorPrimaryDark">@color/bg_canvas</item>
        <item name="colorAccent">@color/accent_primary</item>
        <item name="android:windowBackground">@color/bg_canvas</item>
        <item name="android:statusBarColor">@color/bg_canvas</item>
        <item name="android:navigationBarColor">@color/bg_canvas</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="ZeroCamAlertDialog" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="android:background">@color/bg_surface</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="colorAccent">@color/accent_primary</item>
        <item name="buttonBarPositiveButtonStyle">@style/ZeroCamDialogButtonPrimary</item>
        <item name="buttonBarNegativeButtonStyle">@style/ZeroCamDialogButtonSecondary</item>
    </style>

    <style name="ZeroCamDialogButtonPrimary" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/accent_primary</item>
    </style>

    <style name="ZeroCamDialogButtonSecondary" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/text_secondary</item>
    </style>
</resources>
